{
  "manifest_version": 3,
  "name": "Model Resource Exporter",
  "version": "1.0.0",
  "description": "Find .meshy resources on Meshy pages and export local GLB models as OBJ or STL.",
  "action": {
    "default_title": "Model Resource Exporter",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "downloads"],
  "content_scripts": [
    {
      "matches": ["https://www.meshy.ai/*", "https://meshy.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
